{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/polymorfa/sentinel-tests/blob/main/schemas/case.schema.json",
  "title": "Sentinel reusable behavior fixture",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "title", "module", "export", "context", "probes"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "module": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "export": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "construct": {
      "type": "object",
      "required": ["args"],
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/data"
          }
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["clock", "timezone", "randomSeed", "gates"],
      "properties": {
        "clock": {
          "type": "string",
          "format": "date-time"
        },
        "babelHelpers": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["extends", "taggedTemplateLiteralLoose"]
          }
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "randomSeed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "gates": {
          "type": "object",
          "properties": {
            "abprops": {
              "type": "object"
            },
            "gkx": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "knobs": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "gateUpdates": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": ["beforeProbe", "gates"],
            "properties": {
              "beforeProbe": {
                "type": "string",
                "minLength": 1
              },
              "gates": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/data"
        }
      ]
    },
    "stubs": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["module", "exports"],
        "properties": {
          "module": {
            "type": "string"
          },
          "exports": {
            "$ref": "#/$defs/data"
          }
        },
        "additionalProperties": false
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["id", "args"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/probeData"
            }
          },
          "clock": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "oneOf": [
              {
                "type": "object",
                "required": ["method"],
                "properties": {
                  "method": {
                    "type": "string",
                    "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
                    "not": {
                      "enum": ["constructor", "__proto__", "prototype"]
                    }
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/probeData"
                    }
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["identityWith"],
                "properties": {
                  "identityWith": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\u0000-\\u001f]+$",
                    "not": {
                      "enum": ["constructor", "prototype", "__proto__"]
                    }
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "export": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "method": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
            "not": {
              "enum": ["constructor", "__proto__", "prototype"]
            }
          },
          "expected": {
            "$ref": "#/$defs/data"
          },
          "throws": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "name": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "module": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "pending": {
            "type": "object",
            "required": ["id", "action"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "action": {
                "enum": ["start", "inspect", "await"]
              },
              "property": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
                "not": {
                  "enum": ["constructor", "__proto__", "prototype"]
                }
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "required": ["property"]
                },
                "then": {
                  "properties": {
                    "action": {
                      "const": "start"
                    }
                  }
                }
              }
            ]
          },
          "retain": {
            "type": "object",
            "required": ["id", "stage"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f]+$",
                "not": {
                  "enum": ["constructor", "prototype", "__proto__"]
                }
              },
              "stage": {
                "enum": ["call", "result"]
              }
            },
            "additionalProperties": false
          }
        },
        "oneOf": [
          {
            "required": ["expected"],
            "not": {
              "required": ["throws"]
            }
          },
          {
            "required": ["throws"],
            "not": {
              "required": ["expected"]
            }
          }
        ],
        "additionalProperties": false,
        "dependentRequired": {
          "module": ["export"]
        },
        "allOf": [
          {
            "if": {
              "required": ["module"]
            },
            "then": {
              "not": {
                "required": ["method"]
              }
            }
          },
          {
            "if": {
              "required": ["pending"],
              "properties": {
                "pending": {
                  "properties": {
                    "action": {
                      "enum": ["inspect", "await"]
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "args": {
                  "maxItems": 0
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": ["module"]
                  },
                  {
                    "required": ["export"]
                  },
                  {
                    "required": ["method"]
                  },
                  {
                    "required": ["result"]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "required": ["pending"],
              "properties": {
                "pending": {
                  "required": ["property"]
                }
              }
            },
            "then": {
              "properties": {
                "args": {
                  "maxItems": 0
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": ["module"]
                  },
                  {
                    "required": ["export"]
                  },
                  {
                    "required": ["method"]
                  },
                  {
                    "required": ["result"]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "required": ["retain"]
            },
            "then": {
              "not": {
                "required": ["throws"]
              }
            }
          },
          {
            "if": {
              "required": ["retain"],
              "properties": {
                "retain": {
                  "properties": {
                    "stage": {
                      "const": "result"
                    }
                  }
                }
              }
            },
            "then": {
              "required": ["result"],
              "properties": {
                "result": {
                  "required": ["method"]
                }
              }
            }
          }
        ]
      }
    },
    "sourceExpectation": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/data"
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["construct"]
      },
      "then": {
        "properties": {
          "probes": {
            "items": {
              "not": {
                "required": ["module"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "probes": {
            "contains": {
              "required": ["pending"],
              "properties": {
                "pending": {
                  "required": ["property"]
                }
              }
            }
          }
        }
      },
      "then": {
        "required": ["construct"]
      }
    },
    {
      "if": {
        "properties": {
          "probes": {
            "contains": {
              "required": ["pending"]
            }
          }
        }
      },
      "then": {
        "properties": {
          "probes": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": ["retain"]
                  },
                  {
                    "required": ["result"],
                    "properties": {
                      "result": {
                        "required": ["identityWith"]
                      }
                    }
                  }
                ]
              },
              "properties": {
                "args": {
                  "items": {
                    "$ref": "#/$defs/data"
                  }
                },
                "result": {
                  "properties": {
                    "args": {
                      "items": {
                        "$ref": "#/$defs/data"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "required": ["$type", "value"],
      "properties": {
        "$type": {
          "const": "reference"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f]+$",
          "not": {
            "enum": ["constructor", "prototype", "__proto__"]
          }
        }
      },
      "additionalProperties": false
    },
    "data": {
      "anyOf": [
        {
          "type": ["null", "boolean", "number", "string"]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/data"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/data"
          },
          "not": {
            "required": ["$type"],
            "properties": {
              "$type": {
                "const": "reference"
              }
            }
          }
        }
      ]
    },
    "probeData": {
      "anyOf": [
        {
          "type": ["null", "boolean", "number", "string"]
        },
        {
          "$ref": "#/$defs/reference"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/probeData"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/probeData"
          },
          "not": {
            "required": ["$type"],
            "properties": {
              "$type": {
                "const": "reference"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "required": ["$type"],
                "properties": {
                  "$type": {
                    "const": "function"
                  }
                }
              },
              "then": {
                "properties": {
                  "returns": {
                    "$ref": "#/$defs/data"
                  },
                  "throws": {
                    "$ref": "#/$defs/data"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  },
  "$comment": "Reference handles are available only from earlier probes, with unique bounded retain IDs. Earlier-probe availability, registry budgets and actual realm object identity are enforced by runtime admission, not cross-field JSON Schema evaluation."
}
