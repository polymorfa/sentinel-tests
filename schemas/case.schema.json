{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/polymorfa/sentinel-tests/blob/main/schemas/case.schema.json",
  "title": "Sentinel reusable behavior fixture",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "title", "module", "export", "context", "probes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "module": { "type": "string", "minLength": 1, "maxLength": 256 },
    "export": { "type": "string", "minLength": 1, "maxLength": 256 },
    "construct": {
      "type": "object",
      "required": ["args"],
      "properties": { "args": { "type": "array" } },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["clock", "timezone", "randomSeed", "gates"],
      "properties": {
        "clock": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string", "minLength": 1 },
        "randomSeed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "gates": {
          "type": "object",
          "properties": {
            "abprops": { "type": "object" },
            "gkx": { "type": "object", "additionalProperties": { "type": "boolean" } },
            "knobs": { "type": "object" }
          },
          "additionalProperties": false
        },
        "gateUpdates": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": ["beforeProbe", "gates"],
            "properties": {
              "beforeProbe": { "type": "string", "minLength": 1 },
              "gates": { "type": "object" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "stubs": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["module", "exports"],
        "properties": { "module": { "type": "string" }, "exports": {} },
        "additionalProperties": false
      }
    },
    "variants": { "type": "object", "additionalProperties": { "type": "string" } },
    "probes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["id", "args"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "args": { "type": "array" },
          "clock": { "type": "string", "format": "date-time" },
          "export": { "type": "string", "minLength": 1, "maxLength": 256 },
          "method": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
            "not": { "enum": ["constructor", "__proto__", "prototype"] }
          },
          "expected": {},
          "throws": {
            "type": "object",
            "minProperties": 1,
            "properties": { "name": { "type": "string" }, "message": { "type": "string" } },
            "additionalProperties": false
          }
        },
        "oneOf": [
          { "required": ["expected"], "not": { "required": ["throws"] } },
          { "required": ["throws"], "not": { "required": ["expected"] } }
        ],
        "additionalProperties": false
      }
    },
    "sourceExpectation": { "type": "object" }
  },
  "additionalProperties": false
}
